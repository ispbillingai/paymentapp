<?xml version="1.0" ?>
<resources>
    <color name="brand">#086653</color>
    <color name="brand_dark">#103E34</color>
    <color name="ink">#193E33</color>
    <color name="muted">#617464</color>
    <color name="panel">#EDF4E6</color>
    <color name="paper">#F6F8F1</color>
    <color name="line">#DCE5D5</color>
    <color name="lime">#D0E9AE</color>
    <color name="white">#FFFFFF</color>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Eyebrow" parent="Body">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand</item>
    </style>
    <style name="Heading" parent="Body">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/brand</item>
    </style>
</resources>
